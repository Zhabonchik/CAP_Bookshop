{
  "welcomeFile": "/booksui/test/flpsandbox.html",
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/service/(.*)$",
      "target": "/service/$1",
      "destination": "srv-api",
      "authenticationType": "xsuaa",
      "csrfProtection": true
    },
    {
      "source": "^/(.*)$",
      "target": "$1",
      "service": "html5appsrepo.rt",
      "authenticationType": "xsuaa"
    }
  ]
}